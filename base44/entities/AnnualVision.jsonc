      "type": "string"
    },
    "pillar_2_description": {
      "type": "string"
    },
    "pillar_3_name": {
      "type": "string"
    },
    "pillar_3_description": {
      "type": "string"
    },
    "word_of_year": {
      "type": "string"
    },
    "core_values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
