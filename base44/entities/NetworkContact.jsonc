{
  "name": "NetworkContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "mentor",
        "peer",
        "collaborator",
        "prospect",
        "champion"
      ],
      "default": "peer"
    },
    "last_touch_date": {
      "type": "string",
      "format": "date"
    },
    "next_action": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    }
  },
  "required": [
    "name"
  ]
}